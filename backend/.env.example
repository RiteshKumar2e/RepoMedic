# =============================================================================
# RepoMedic — backend environment
# Copy to backend/.env and fill in. Never commit the real .env.
# =============================================================================

# ---- Application ----------------------------------------------------------
APP_ENV=development
APP_NAME=RepoMedic
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# Strict CORS allowlist: the only browser origin allowed to call the API.
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
# Serve seeded demo data so the product is explorable without GitHub creds.
DEMO_MODE=true

# ---- Database (Turso / libSQL) --------------------------------------------
# Turso:  DATABASE_URL=sqlite+libsql://your-db-org.turso.io
#         DATABASE_AUTH_TOKEN=<turso db tokens create your-db>
# Leave DATABASE_URL empty to use a local SQLite file (backend/data/repomedic.db).
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ---- Secrets ---------------------------------------------------------------
# JWT_SECRET: openssl rand -hex 32
JWT_SECRET=
# ENCRYPTION_KEY: Fernet key used to encrypt GitHub tokens at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
JWT_EXPIRE_MINUTES=720
COOKIE_NAME=repomedic_session
COOKIE_SECURE=false
COOKIE_DOMAIN=
# lax | strict | none. Use "none" when the frontend and API are on different
# sites (e.g. Vercel + Render) — a Lax cookie is never sent cross-site, which
# breaks the SSE progress stream. "none" implies Secure, so it needs HTTPS.
COOKIE_SAMESITE=lax

# ---- GitHub ----------------------------------------------------------------
# OAuth App (user login) — see docs/github-app-setup.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=read:user,user:email,repo
# GitHub App (repository access + checks + webhooks)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com

# ---- LLM providers ---------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# gemini | groq | local | heuristic
# "heuristic" is the offline, no-network provider used for demos and CI.
DEFAULT_LLM_PROVIDER=heuristic
DEFAULT_LLM_MODEL=gemini-2.5-flash

# ---- Queue / cache ---------------------------------------------------------
# Leave empty to run analyses in an in-process background worker (dev only).
REDIS_URL=redis://localhost:6379/0

# ---- Analysis workspace ----------------------------------------------------
WORKSPACE_ROOT=./.workspaces
MAX_REPOSITORY_SIZE_MB=200
WORKSPACE_RETENTION_MINUTES=60
MAX_ANALYSIS_COST_USD=2
MAX_CONTEXT_FILES=24
MAX_CONTEXT_TOKENS=60000
AGENT_MAX_STEPS=12

# ---- Sandboxing ------------------------------------------------------------
# docker      = run scanners/tests inside a network-disabled container (required for prod)
# subprocess  = run scanners on the host (development convenience only)
# disabled    = skip every external tool
SANDBOX_MODE=subprocess
SANDBOX_IMAGE=repomedic/sandbox:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=1g
SCANNER_TIMEOUT_SECONDS=120
# Executing repository test suites on the host is unsafe; keep false unless SANDBOX_MODE=docker.
ALLOW_HOST_TEST_EXECUTION=false

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
